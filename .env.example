# Public values only (VITE_* is bundled into the browser). Never put private API keys here.
VITE_CONTACT_EMAIL=hello@your-domain.com
VITE_SITE_URL=https://www.your-domain.com
# Optional: form service endpoint (e.g. Formspree https://formspree.io/f/xxxx). Empty = mailto fallback.
VITE_FORM_ENDPOINT=
VITE_LINKEDIN_URL=
VITE_GITHUB_URL=
VITE_X_URL=
